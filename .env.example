# Copy this file to .env at the repository root and replace the example URLs.
# Use distinct, direct PostgreSQL endpoints with full TLS certificate verification.
# Percent-encode URL metacharacters in credentials.

# Neon dev branch for the API, migrations, and seed data.
DATABASE_URL=postgresql://example_user:example_password@dev.example.invalid/be_fast?sslmode=verify-full
# Neon test branch for integration tests only.
TEST_DATABASE_URL=postgresql://example_user:example_password@test.example.invalid/be_fast?sslmode=verify-full

# API interface and port for local requests.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Base64url-encoded random key of at least 32 bytes for JWTs and OTP hashing.
# AUTH_SECRET=

# Optional local credentials for the first seeded developer admin.
# Supply both before running db:seed to sign in with the seeded admin.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_TOTP_SECRET=

# Credentials supplied only when running admin:create. The TOTP secret is Base32.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_TOTP_SECRET=
