# Optional local overrides. Copy this file to .env at the repository root.
# All credentials below are public development defaults for loopback use.

# Initializes the PostgreSQL user, password, and database on a new volume.
POSTGRES_USER=be_fast
POSTGRES_PASSWORD=be_fast_dev_only
POSTGRES_DB=be_fast
# Loopback port published by Docker Compose.
POSTGRES_PORT=5432

# PostgreSQL connection string used by the API and integration tests.
# If you change the PostgreSQL values above, update this URL to match.
# Percent-encode URL metacharacters in the username or password.
DATABASE_URL=postgresql://be_fast:be_fast_dev_only@127.0.0.1:5432/be_fast

# API interface and port for local requests.
HOST=127.0.0.1
PORT=3001

# Development MinIO administrator and password for S3 and the console.
MINIO_ROOT_USER=be_fast
MINIO_ROOT_PASSWORD=be_fast_minio_dev_only
# Loopback ports published for the S3 API and the MinIO console.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
