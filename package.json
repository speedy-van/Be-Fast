{
  "name": "be-fast",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "db:check": "node --env-file-if-exists=.env apps/api/scripts/db-check.mjs",
    "db:migrate": "node -e \"console.log('No migrations in M0.')\"",
    "db:seed": "node -e \"console.log('No seed data in M0.')\"",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run build --filter=./packages/* && node node_modules/vitest/vitest.mjs run",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
